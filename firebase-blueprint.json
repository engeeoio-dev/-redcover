      },
      "required": [
        "id",
        "reporterId",
        "targetType",
        "targetId",
        "targetTitle",
        "reason",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
