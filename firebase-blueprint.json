        "userAvatar",
        "text",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private user PII and account settings."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Books and stories catalog."
    },
    "/books/{bookId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapters belonging to a specific book."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Book reviews and ratings."
    },
    "/readingProgress/{progressId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "User reading progress and bookmarks."
    },
    "/saves/{saveId}": {
      "schema": { "$ref": "#/entities/SavedBook" },
      "description": "Saved books in personal libraries."
    },
    "/likes/{likeId}": {
      "schema": { "$ref": "#/entities/BookLike" },
      "description": "User likes on books."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "User follow relationships."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friend requests, friendships, and blocks."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct messaging threads."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a direct chat thread."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
