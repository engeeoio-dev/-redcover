{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile for a Redcover reader or author (PII isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 60 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "coverURL": { "type": "string", "maxLength": 1000 },
        "bio": { "type": "string", "maxLength": 1000 },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "booksCount": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "points": { "type": "integer" },
        "membershipPlan": { "type": "string", "enum": ["free", "premium"] },
        "isOnline": { "type": "boolean" },
        "showOnlineStatus": { "type": "boolean" },
        "publicActivity": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "author", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "photoURL",
        "coverURL",
        "bio",
        "followersCount",
        "followingCount",
        "booksCount",
        "streakDays",
        "points",
        "membershipPlan",
        "isOnline",
        "showOnlineStatus",
        "publicActivity",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII and account settings for a Redcover user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 254 },
        "readingReminders": { "type": "boolean" },
        "notificationSettings": { "type": "string", "enum": ["all", "important", "none"] },
        "theme": { "type": "string", "enum": ["light", "dark", "sepia"] },
        "subscriptionExpiry": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "readingReminders", "notificationSettings", "theme", "updatedAt"]
    },
    "Book": {
      "title": "Book",
      "description": "A book or story published or drafted on Redcover.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "shortDescription": { "type": "string", "maxLength": 400 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authorUsername": { "type": "string", "maxLength": 80 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "coverURL": { "type": "string", "maxLength": 1000 },
        "fileURL": { "type": "string", "maxLength": 1000 },
        "format": { "type": "string", "enum": ["story", "pdf"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "language": { "type": "string", "minLength": 1, "maxLength": 60 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "integer" },
        "views": { "type": "integer" },
        "likes": { "type": "integer" },
        "saves": { "type": "integer" },
        "chaptersCount": { "type": "integer" },
        "featured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "pending", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "description",
        "shortDescription",
        "authorId",
        "authorName",
        "authorUsername",
        "authorAvatar",
        "coverURL",
        "fileURL",
        "format",
        "category",
        "language",
        "rating",
        "reviewsCount",
        "views",
        "likes",
        "saves",
        "chaptersCount",
        "featured",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "A chapter inside a book on Redcover.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookStatus": { "type": "string", "enum": ["draft", "published", "pending", "removed"] },
        "chapterNumber": { "type": "integer" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "bookId",
        "authorId",
        "bookStatus",
        "chapterNumber",
        "title",
        "content",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "User review and rating for a book.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "integer" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "visibility": { "type": "string", "enum": ["public", "hidden"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "bookId",
        "bookTitle",
        "userId",
        "userName",
        "userAvatar",
        "rating",
        "text",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Synchronized reading progress and bookmark position for a user on a book.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "bookCover": { "type": "string", "maxLength": 1000 },
        "bookAuthor": { "type": "string", "maxLength": 120 },
        "currentChapter": { "type": "integer" },
        "totalChapters": { "type": "integer" },
        "percentage": { "type": "integer" },
        "bookmarkNote": { "type": "string", "maxLength": 5000 },
        "isBookmarked": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "bookId",
        "bookTitle",
        "bookCover",
        "bookAuthor",
        "currentChapter",
        "totalChapters",
        "percentage",
        "bookmarkNote",
        "isBookmarked",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedBook": {
      "title": "SavedBook",
      "description": "Book saved to a user's library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookId", "createdAt"]
    },
    "BookLike": {
      "title": "BookLike",
      "description": "User like on a book.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetAuthorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookId", "targetAuthorId", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follower-following relationship between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "followerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "followingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "followerName": { "type": "string", "maxLength": 100 },
        "followingName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "followerId", "followingId", "followerName", "followingName", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friend request, active friendship, or blocked state between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterName": { "type": "string", "maxLength": 100 },
        "receiverName": { "type": "string", "maxLength": 100 },
        "requesterAvatar": { "type": "string", "maxLength": 1000 },
        "receiverAvatar": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "requesterId",
        "receiverId",
        "requesterName",
        "receiverName",
        "requesterAvatar",
        "receiverAvatar",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct messaging conversation thread between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantA": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantB": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantAName": { "type": "string", "maxLength": 100 },
        "participantBName": { "type": "string", "maxLength": 100 },
        "participantAAvatar": { "type": "string", "maxLength": 1000 },
        "participantBAvatar": { "type": "string", "maxLength": 1000 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastSenderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "unreadCountA": { "type": "integer" },
        "unreadCountB": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "participantA",
        "participantB",
        "participantAName",
        "participantBName",
        "participantAAvatar",
        "participantBAvatar",
        "lastMessage",
        "lastSenderId",
        "unreadCountA",
        "unreadCountB",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a direct chat thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderId", "receiverId", "text", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for social, messages, books, or membership events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["social", "messages", "books", "membership"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "minLength": 1, "maxLength": 600 },
        "link": { "type": "string", "maxLength": 300 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "recipientId",
        "actorId",
        "actorName",
        "category",
        "title",
        "body",
        "link",
        "read",
        "createdAt",
        "updatedAt"
      ]
    },
    "Report": {
      "title": "Report",
      "description": "Content or user moderation report submitted by a user.",
      "type": "object",
